<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/main"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".RegistroActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="@dimen/margin_screen"
        android:paddingEnd="@dimen/margin_screen"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/logoRegistro"
                android:layout_width="@dimen/logo_size"
                android:layout_height="@dimen/logo_size"
                android:layout_marginBottom="@dimen/space_lg"
                android:contentDescription="@string/logo_campus"
                android:src="@drawable/logo_campus_estudiantil" />

            <TextView
                android:id="@+id/txtTituloRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Crear cuenta"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSubtituloRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:layout_marginBottom="@dimen/space_lg"
                android:gravity="center"
                android:text="Registrate para acceder al campus"
                android:textColor="@color/textSecondary"
                android:textSize="@dimen/text_regular" />

            <EditText
                android:id="@+id/inputNombreRegistro"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="@dimen/form_field_margin"
                android:background="@drawable/bg_input"
                android:hint="Nombre completo"
                android:inputType="textPersonName"
                android:padding="@dimen/padding_small"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/textSecondary"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/inputEmailRegistro"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="@dimen/form_field_margin"
                android:background="@drawable/bg_input"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:padding="@dimen/padding_small"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/textSecondary"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/inputPasswordRegistro"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="@dimen/form_field_margin"
                android:background="@drawable/bg_input"
                android:hint="Contraseña"
                android:inputType="textPassword"
                android:padding="@dimen/padding_small"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/textSecondary"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/inputConfirmarPasswordRegistro"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="@dimen/space_lg"
                android:background="@drawable/bg_input"
                android:hint="Confirmar contraseña"
                android:inputType="textPassword"
                android:padding="@dimen/padding_small"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/textSecondary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnRegistrarme"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_button"
                android:backgroundTint="@null"
                android:text="Registrarme"
                android:textAllCaps="false"
                android:textColor="@color/textWhite"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtVolverLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center"
                android:text="Ya tengo cuenta"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/text_regular"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>