<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".GruposActivity">

    <TextView
        android:id="@+id/tituloGrupos"
        android:layout_width="0dp"
        android:layout_height="@dimen/topbar_height"
        android:background="@color/colorPrimary"
        android:gravity="center"
        android:text="@string/titulo_grupos"
        android:textColor="@color/textWhite"
        android:textSize="@dimen/text_title"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/contenedorTabs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_screen"
        android:orientation="horizontal"
        android:padding="@dimen/padding_small"
        app:layout_constraintTop_toBottomOf="@id/tituloGrupos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tabBuscarGrupos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/colorPrimary"
            android:gravity="center"
            android:padding="@dimen/padding_small"
            android:text="@string/buscar_grupos"
            android:textColor="@color/colorTextButton"
            android:textSize="@dimen/text_regular"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabMisGrupos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_weight="1"
            android:background="@color/cardBackground"
            android:gravity="center"
            android:padding="@dimen/padding_small"
            android:text="@string/mis_grupos"
            android:textColor="@color/textSecondary"
            android:textSize="@dimen/text_regular" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollGrupos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/margin_screen"
        android:layout_marginEnd="@dimen/margin_screen"
        android:layout_marginBottom="@dimen/margin_between_cards"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/contenedorTabs"
        app:layout_constraintBottom_toTopOf="@id/btnCrearGrupo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/contenedorListaGrupos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/cardGrupoBaseDatos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_between_cards"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/padding_card">

                <TextView
                    android:id="@+id/tituloGrupo1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/grupo_base_datos"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/text_large"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detalleGrupo1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/grupo_base_datos_detalle"
                    android:textColor="@color/textMuted"
                    android:textSize="@dimen/text_medium" />

                <LinearLayout
                    android:id="@+id/filaAccionesGrupo1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/estadoGrupo1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_green"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="6dp"
                        android:text="@string/grupo_estado_abierto"
                        android:textColor="@color/colorSuccess"
                        android:textSize="@dimen/text_small"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnUnirseGrupo1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:background="@drawable/bg_chip_gray"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="18dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="6dp"
                        android:text="@string/unirme_grupo"
                        android:textColor="@color/textSecondary"
                        android:textSize="@dimen/text_small" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardGrupoProgramacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_between_cards"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/padding_card">

                <TextView
                    android:id="@+id/tituloGrupo2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/grupo_programacion"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/text_large"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detalleGrupo2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/grupo_programacion_detalle"
                    android:textColor="@color/textMuted"
                    android:textSize="@dimen/text_medium" />

                <TextView
                    android:id="@+id/estadoGrupo2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:background="@drawable/bg_chip_red"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="6dp"
                    android:text="@string/grupo_estado_cerrado"
                    android:textColor="@color/colorDanger"
                    android:textSize="@dimen/text_small"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <Button
        android:id="@+id/btnCrearGrupo"
        android:layout_width="@dimen/button_width"
        android:layout_height="@dimen/button_height"
        android:layout_marginStart="@dimen/margin_screen"
        android:layout_marginEnd="@dimen/margin_screen"
        android:layout_marginBottom="@dimen/margin_button_bottom"
        android:background="@drawable/bg_button"
        android:backgroundTint="@null"
        android:text="@string/crear_grupo"
        android:textAllCaps="false"
        android:textColor="@color/colorTextButton"
        android:textSize="@dimen/text_regular"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>